<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that doesn't need Windows: link rules, tabs, profiles, the server's API, the drive's bookkeeping.
       Kept apart so the tests run anywhere (dotnet test). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pinned past 2.1.11, which has a known high-severity SQLite advisory (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mnemerynne.Core.Tests" />
  </ItemGroup>
</Project>
