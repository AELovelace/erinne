<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app itself: a WPF window of tabs, each a WebView2 (the Edge engine built into Windows), plus the tray. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>          <!-- only for the tray icon (NotifyIcon) -->
    <AssemblyName>Mnemerynne.Desktop</AssemblyName>
    <RootNamespace>Mnemerynne.Desktop</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinForms is only here for the tray icon (used as Forms.NotifyIcon): keep its names out of every file,
         so Button, Point, KeyEventArgs... always mean WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mnemerynne.Core\Mnemerynne.Core.csproj" />
    <ProjectReference Include="..\Mnemerynne.Drive\Mnemerynne.Drive.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
