<Window x:Class="Mnemerynne.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mnemerynne.Desktop"
        Title="Mnemerynne" Height="860" Width="1320" MinWidth="560" MinHeight="400"
        Background="{DynamicResource Strip}" Icon="Assets/app.ico"
        PreviewKeyDown="OnKeyDown" Closing="OnClosing" StateChanged="OnStateChanged">
    <!-- One window = one server (profile). Like Edge: no separate title bar and no address bar. The tabs ARE the
         title bar: one row with the server menu, back/forward/reload, the tabs, + , the drive's status and the
         window's own minimise/maximise/close. WindowChrome draws the window without Windows' title bar while keeping
         dragging, double-click to maximise, snapping and resizing; buttons in that row are marked
         IsHitTestVisibleInChrome so they still take clicks. The pages are WebView2 controls stacked in PagesHost. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Colours (Strip, TabActive, TabHover, Ink, Muted, Accent, Menu*) aren't here: they come from the site's
             theme (ThemeColors.cs, merged in by MainWindow.xaml.cs), so every use below is a DynamicResource. -->

        <!-- Flat round-cornered buttons for the title row. Clickable inside the window's drag area. -->
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3A3341"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The strip: one row holding tabs and tab-group labels (MainWindow.Regroup builds it). Each kind of item has
             its own look below, picked by type. -->
        <ItemsPanelTemplate x:Key="TabRow"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>

        <!-- One tab: icon, title, ×. Click shows it, middle-click or × closes it, right-click has the group menu, drag
             moves it within its own block. Places (Ask, Files…) are compact and wear the flower, where you work; opened
             things (a file, the editor, a wiki page, Help) are full width with no flower (Doll). A tab in a group is
             underlined in the group's colour. -->
        <DataTemplate DataType="{x:Type local:BrowserTab}">
            <Border x:Name="Tab" Width="{Binding TabWidth}" Height="34" Margin="1,6,1,0" CornerRadius="8,8,0,0"
                    Background="Transparent" Cursor="Hand" ToolTip="{Binding Title}"
                    MouseLeftButtonDown="OnTabMouseDown" MouseMove="OnTabMouseMove" MouseUp="OnTabMouseUp"
                    MouseRightButtonUp="OnTabRightClick">
                <Grid>
                    <DockPanel Margin="10,0,4,0">
                        <Image x:Name="Flower" DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Content="✕" AutomationProperties.Name="Close tab"
                                FontSize="10" Padding="5,2" Click="OnTabClose" ToolTip="Close tab (Ctrl+W)"/>
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <!-- the group's colour along the bottom (none when it's in no group) -->
                    <Border Height="2" VerticalAlignment="Bottom" Margin="6,0" CornerRadius="1"
                            Background="{Binding Group.Brush, FallbackValue={x:Null}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter TargetName="Tab" Property="Background" Value="{DynamicResource TabActive}"/>
                </DataTrigger>
                <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tab" Property="Background" Value="{DynamicResource TabHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsDocument}" Value="True">
                    <Setter TargetName="Flower" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A tab group's label, before its tabs: the name in the group's colour (with the tab count while folded).
             Click folds or unfolds the group; right-click has Rename, Colour, Ungroup, Close group; drop a tab on it to
             add the tab to the group. -->
        <DataTemplate DataType="{x:Type local:TabGroup}">
            <Border x:Name="Chip" Height="24" Margin="6,9,3,1" Padding="9,0" CornerRadius="7" Cursor="Hand"
                    Background="{Binding Tint}" BorderBrush="{Binding Brush}" BorderThickness="1"
                    ToolTip="Click to fold or unfold; right-click for more" AllowDrop="True" Drop="OnGroupDrop"
                    MouseLeftButtonUp="OnGroupClick" MouseRightButtonUp="OnGroupRightClick">
                <TextBlock Text="{Binding Label}" Foreground="{Binding Brush}" FontWeight="SemiBold" FontSize="12.5"
                           VerticalAlignment="Center" FontFamily="{DynamicResource MenuFont}"/>
            </Border>
        </DataTemplate>

        <!-- The window's own buttons (minimise, maximise, close): square, full height, like Windows' own. -->
        <Style x:Key="Caption" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3A3341"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaption" TargetType="Button" BasedOn="{StaticResource Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#C42B1C"/>   <!-- Windows' red -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- RootGrid's margin is set while maximised (OnStateChanged): Windows pushes a maximised window's edges just
         past the screen, so without it the top row would be clipped. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>    <!-- the one top row: tabs + window buttons -->
            <RowDefinition Height="Auto"/>  <!-- banner (updates, sign-in) -->
            <RowDefinition Height="*"/>     <!-- the pages -->
        </Grid.RowDefinitions>

        <!-- ============================== the top row ============================== -->
        <DockPanel Grid.Row="0" Background="{DynamicResource Strip}" LastChildFill="True">
            <!-- Left: the server menu, then back / forward / reload for the showing tab. -->
            <!-- The server's name: opens the pages menu (Ask, Files, Wiki…), read from the site itself. Its badge adds
                 up unread messages and proposals waiting, as the site's own flower did. -->
            <Button x:Name="PagesButton" DockPanel.Dock="Left" Style="{StaticResource Flat}" Margin="6,4,2,4" Click="OnPagesMenu"
                    ToolTip="Pages" AutomationProperties.Name="Pages">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="ServerIcon" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <!-- The name, centred on the flower's middle (NameNudge: the font sits a little low in its box), with
                         the site's glitch (erynne.css .brand-glitch): a cyan and a red copy that flash in now and then,
                         sliced and nudged sideways (MainWindow.xaml.cs, GlitchAsync). -->
                    <Grid x:Name="NameHost" VerticalAlignment="Center">
                        <TextBlock x:Name="ServerName" Text="Mnemerynne" FontWeight="SemiBold" FontFamily="{DynamicResource MenuFont}"/>
                        <TextBlock x:Name="GlitchCyan" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource MenuFont}" Foreground="#00F0FF" Opacity="0" IsHitTestVisible="False">
                            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="GlitchRed" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource MenuFont}" Foreground="#FF1450" Opacity="0" IsHitTestVisible="False">
                            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text=" ▾" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <Border x:Name="NavBadge" Visibility="Collapsed" Background="{DynamicResource Accent}" CornerRadius="8"
                            Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NavBadgeText" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Strip}"/>
                    </Border>
                </StackPanel>
            </Button>
            <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource Flat}" Content="←" AutomationProperties.Name="Back" Margin="2,4,0,4"
                    Click="OnBack" ToolTip="Back (Alt+Left)"/>
            <Button x:Name="ForwardButton" DockPanel.Dock="Left" Style="{StaticResource Flat}" Content="→" AutomationProperties.Name="Forward" Margin="0,4"
                    Click="OnForward" ToolTip="Forward (Alt+Right)"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource Flat}" Content="⟳" AutomationProperties.Name="Reload" Margin="0,4,6,4"
                    Click="OnReload" ToolTip="Reload (F5)"/>

            <!-- Right: the window's own buttons, then (to their left) the drive's status. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaption}" Content="&#xE8BB;" Click="OnCloseWindow" AutomationProperties.Name="Close"
                    ToolTip="Close (keeps running in the tray)"/>
            <Button x:Name="MaxButton" DockPanel.Dock="Right" Style="{StaticResource Caption}" Content="&#xE922;" AutomationProperties.Name="Maximise"
                    Click="OnMaxRestore" ToolTip="Maximise"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" Content="&#xE921;" Click="OnMinimise" AutomationProperties.Name="Minimise"
                    ToolTip="Minimise"/>
            <!-- ⚙: servers, settings, the drive, sign-in, updates, quit (right of the drive's status). -->
            <!-- Same quiet colour as the drive's status beside it (Doll: it shouldn't stand out); Windows' thin gear glyph. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                    FontSize="14" Foreground="{DynamicResource Muted}" Margin="2,4,6,4"
                    Click="OnSystemMenu" ToolTip="Servers, settings and sign-in" AutomationProperties.Name="Settings menu"/>
            <Button x:Name="DriveButton" DockPanel.Dock="Right" Style="{StaticResource Flat}" Margin="4,4,8,4"
                    Click="OnDriveButton" ToolTip="Open the drive in File Explorer">
                <TextBlock x:Name="DriveStatus" Text="" Foreground="{DynamicResource Muted}" FontSize="12"/>
            </Button>

            <!-- Middle: the tabs, sorted by themselves (TabKinds.cs): the site's places first (Ask, Files, Automator…),
                 then what's been opened (a Markdown file, a spreadsheet, a PDF, the editor, a wiki page, Help). One row,
                 no divider. Then +, and empty space that drags the window, as in Edge. -->
            <Grid x:Name="TabArea" SizeChanged="OnTabAreaSized">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- the tabs (they shrink to fit, then scroll) -->
                    <ColumnDefinition Width="Auto"/>   <!-- + -->
                    <ColumnDefinition Width="*"/>      <!-- empty: drags the window -->
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="StripScroller" Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnStripWheel" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ItemsControl x:Name="TabStrip" AllowDrop="True" Drop="OnTabDrop" DragOver="OnTabDragOver"
                                  ItemsPanel="{StaticResource TabRow}"/>
                </ScrollViewer>
                <Button Grid.Column="1" Style="{StaticResource Flat}" Content="＋" AutomationProperties.Name="New tab" Margin="4,4,0,4" Click="OnNewTab" ToolTip="New tab (Ctrl+T)"/>
            </Grid>
        </DockPanel>

        <!-- ============================== banner ============================== -->
        <Border x:Name="Banner" Grid.Row="1" Background="#3B2A35" Visibility="Collapsed" Padding="12,6">
            <DockPanel>
                <Button x:Name="BannerClose" DockPanel.Dock="Right" Style="{StaticResource Flat}" Content="Later" Click="OnBannerLater"/>
                <Button x:Name="BannerAction" DockPanel.Dock="Right" Style="{StaticResource Flat}" Foreground="{DynamicResource Accent}"
                        FontWeight="SemiBold" Click="OnBannerAction"/>
                <TextBlock x:Name="BannerText" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- ============================== pages ============================== -->
        <Grid x:Name="PagesHost" Grid.Row="2" Background="White"/>
    </Grid>
</Window>
