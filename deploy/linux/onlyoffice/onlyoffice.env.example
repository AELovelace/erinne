# ONLYOFFICE Docs settings for the container (README "ONLYOFFICE").
# onlyoffice-setup.sh install writes the real one to /etc/mnemerynne/onlyoffice.env (root only, mode 0600)
# with a fresh secret, and puts the same secret in mnemerynne.env as MNEMERYNNE_ONLYOFFICE_JWT_SECRET.
# This copy is only to show the shape: never put a real secret in the repository.

# Every request between the app and the document server is signed; unsigned ones are refused.
JWT_ENABLED=true
# 64 hex characters (openssl rand -hex 32). Must match MNEMERYNNE_ONLYOFFICE_JWT_SECRET exactly.
JWT_SECRET=change-me-the-setup-script-generates-this
# The header the token travels in (ONLYOFFICE's default).
JWT_HEADER=Authorization
# The container fetches files from the host's address, which ONLYOFFICE treats as private and blocks without this.
ALLOW_PRIVATE_IP_ADDRESS=true
