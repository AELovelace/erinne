[Unit]
Description=llama.cpp Qwen3-Embedding for Mnemerynne (127.0.0.1:8085)
After=network.target

[Service]
Type=simple
User=mnemerynne
Group=mnemerynne
# On the GTX 1050 Ti with the CUDA build of llama.cpp in /opt/llama.cpp (the
# one MicroJames installed). That build sees only the NVIDIA card, so CUDA0 is
# always the 1050 Ti. Embedding on the RX 580 (Vulkan) hung the GPU under
# import load; the generator keeps the RX 580 to itself.
Environment=LD_LIBRARY_PATH=/opt/llama.cpp
# CUDA needs /dev/nvidia-uvm, which only root can create and which doesn't
# exist after boot until something asks for it: create it first, as root ("+"),
# without failing if nvidia-modprobe is missing ("-"). Without it, the start
# fails with "failed to initialize CUDA: unknown error" / "invalid device: CUDA0".
ExecStartPre=-+/usr/bin/nvidia-modprobe -u -c=0
# Qwen3-Embedding needs last-token pooling. Each input must fit one
# micro-batch: -ub 2048 is far above a 512-token chunk.
# To run it on the CPU instead, replace "-dev CUDA0 -ngl 99" with
# "--device none -ngl 0" (questions stay fast; bulk imports become slow).
ExecStart=/opt/llama.cpp/llama-server --host 127.0.0.1 --port 8085 -dev CUDA0 -ngl 99 \
    -m /opt/models/Qwen3-Embedding-0.6B-Q8_0.gguf --embedding --pooling last \
    -c 8192 -np 4 -b 2048 -ub 2048
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
