[Unit]
Description=Mnemerynne web app (127.0.0.1:38200)
After=network.target mnemerynne-generator.service mnemerynne-embedder.service
Wants=mnemerynne-generator.service mnemerynne-embedder.service

[Service]
Type=simple
User=mnemerynne
Group=mnemerynne
WorkingDirectory=/opt/mnemerynne
EnvironmentFile=/etc/mnemerynne/mnemerynne.env
Environment=PYTHONUNBUFFERED=1
# Media transcodes on the GPUs: /dev/dri/renderD* (VAAPI on the RX 580) needs render; video covers
# the older device nodes. NVENC uses /dev/nvidia*, which the driver leaves open to everyone.
SupplementaryGroups=render video
ExecStart=/opt/mnemerynne/.venv/bin/mnemerynne serve
Restart=on-failure
RestartSec=5
# serve gives open requests 10 s to finish; never wait systemd's default 90 s.
TimeoutStopSec=30
# /var/lib/mnemerynne, created with the right owner and SELinux label.
StateDirectory=mnemerynne
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
# The SMB share and its trash (MNEMERYNNE_SHARE_ROOT); "-" = fine if absent.
ReadWritePaths=-/srv/storage
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
