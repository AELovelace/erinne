[Unit]
Description=Mnemerynne nightly backup

[Service]
Type=oneshot
User=mnemerynne
Group=mnemerynne
WorkingDirectory=/opt/mnemerynne
EnvironmentFile=/etc/mnemerynne/mnemerynne.env
ExecStart=/opt/mnemerynne/.venv/bin/mnemerynne backup --dest /var/backups/mnemerynne --keep 14
StateDirectory=mnemerynne
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/mnemerynne
