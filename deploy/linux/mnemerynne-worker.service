[Unit]
Description=Mnemerynne ingestion worker (uploads -> searchable chunks)
After=network.target mnemerynne-embedder.service
Wants=mnemerynne-embedder.service

[Service]
Type=simple
User=mnemerynne
Group=mnemerynne
WorkingDirectory=/opt/mnemerynne
EnvironmentFile=/etc/mnemerynne/mnemerynne.env
Environment=PYTHONUNBUFFERED=1
# ocrmypdf/tesseract need a writable home for caches.
Environment=HOME=/var/lib/mnemerynne
ExecStart=/opt/mnemerynne/.venv/bin/mnemerynne worker
# SIGTERM: finish the current file, then exit.
KillSignal=SIGTERM
TimeoutStopSec=600
Restart=on-failure
RestartSec=10
StateDirectory=mnemerynne
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
