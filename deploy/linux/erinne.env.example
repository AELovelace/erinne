# /etc/erinne/erinne.env — read by the erinne services and by erinne-admin.
# Owner root:erinne, mode 640. No inline comments: systemd would keep them
# as part of the value.

ERINNE_DATA_DIR=/var/lib/erinne

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ERINNE_SECRET_KEY=change-me

ERINNE_HOST=127.0.0.1
ERINNE_PORT=38200

# Behind nginx with TLS.
ERINNE_SESSION_HTTPS_ONLY=true

# Trust X-Forwarded-For from nginx on this box (login throttling sees real IPs).
FORWARDED_ALLOW_IPS=127.0.0.1

# Generator: the llama-generator unit (shared with MicroJames during the pilot).
ERINNE_LLM_URL=http://127.0.0.1:8081
ERINNE_LLM_MODEL=lfm2.5-2.6b-q4_k_m

# Embedder: erinne-embedder unit (Qwen3-Embedding-0.6B). The model, dimension
# and query instruction defaults match it, so only the URL is set here.
ERINNE_EMBED_URL=http://127.0.0.1:8085

# Long-term memory: auto, explicit or off.
ERINNE_MEMORY_MODE=auto
