# /etc/mnemerynne/mnemerynne.env — read by the mnemerynne services and by mnemerynne-admin.
# Owner root:mnemerynne, mode 640. No inline comments: systemd would keep them
# as part of the value.

MNEMERYNNE_DATA_DIR=/var/lib/mnemerynne

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MNEMERYNNE_SECRET_KEY=change-me

MNEMERYNNE_HOST=127.0.0.1
MNEMERYNNE_PORT=38200

# Behind Caddy with TLS.
MNEMERYNNE_SESSION_HTTPS_ONLY=true

# The address people open Erynne at; citation links sent to Claude use it.
MNEMERYNNE_PUBLIC_URL=https://erynne.example.internal

# Trust X-Forwarded-For from Caddy on this box (login throttling sees real IPs).
FORWARDED_ALLOW_IPS=127.0.0.1

# Generator: the mnemerynne-generator unit (Mnemerynne's own; MicroJames keeps :8081).
MNEMERYNNE_LLM_URL=http://127.0.0.1:8086
MNEMERYNNE_LLM_MODEL=lfm2.5-2.6b-q4_k_m
# Room for LFM2.5 to think before each answer (tokens). Raise it if the log
# says a reply "hit the ...-token limit ... thinking"; 0 for a non-thinking model.
MNEMERYNNE_LLM_REASONING_TOKENS=1024

# Embedder: mnemerynne-embedder unit (Qwen3-Embedding-0.6B). The model, dimension
# and query instruction defaults match it, so only the URL is set here.
MNEMERYNNE_EMBED_URL=http://127.0.0.1:8085

# Long-term memory: auto, explicit or off.
MNEMERYNNE_MEMORY_MODE=auto
