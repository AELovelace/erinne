[Unit]
Description=llama.cpp generator for Mnemerynne (127.0.0.1:8086)
After=network.target

[Service]
Type=simple
User=mnemerynne
Group=mnemerynne
# The RX 580 is reached through /dev/dri (Vulkan). MNEMERYNNE_GPU, the llama.cpp
# device (e.g. Vulkan1), comes from the gpu.conf drop-in that preinstall.sh
# writes; without it the unit fails rather than picking the wrong card.
SupplementaryGroups=render video
Environment=LD_LIBRARY_PATH=/opt/llama.cpp-vulkan
# Mesa keeps its compiled shaders here; without it every start recompiles them.
CacheDirectory=mnemerynne-llama
Environment=XDG_CACHE_HOME=/var/cache/mnemerynne-llama
# Localhost only: llama-server has no authentication. 16k context split
# across 2 slots. To run Qwen3-8B instead, change -m and the label in
# MNEMERYNNE_LLM_MODEL; keep -c at 16384 or lower on the 8 GB card.
#
# LFM2.5 (and models fine-tuned from it) is a reasoning model whose own chat
# template always opens a <think> block. lfm2-no-think.jinja is that template
# without the forced <think>, matching how fine-tuning trains (answers, no
# thinking); --reasoning-format none makes llama-server apply Mnemerynne's JSON
# schemas from the first token, so the model answers instead of thinking until
# it runs out of tokens. Keep both for any LFM2.5-based model, fine-tunes too;
# drop both for Qwen3, whose template honours enable_thinking=false.
ExecStart=/opt/llama.cpp-vulkan/llama-server --host 127.0.0.1 --port 8086 -dev ${MNEMERYNNE_GPU} -ngl 99 \
    -m /opt/models/LFM2.5-2.6B-Q4_K_M.gguf -c 16384 -np 2 \
    --jinja --chat-template-file /opt/mnemerynne/deploy/linux/lfm2-no-think.jinja --reasoning-format none
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
