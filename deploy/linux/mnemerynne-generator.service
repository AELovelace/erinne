[Unit]
Description=llama.cpp generator for Mnemerynne (127.0.0.1:8086)
After=network.target

[Service]
Type=simple
User=mnemerynne
Group=mnemerynne
# The RX 580 is reached through /dev/dri (Vulkan). Only Mesa's Radeon driver is
# loaded, so the RX 580 is the only Vulkan device and always Vulkan0. With the
# NVIDIA driver also visible, the Vulkan device numbers can swap after a driver
# update, which put this model on the 1050 Ti next to the embedder.
# VK_DRIVER_FILES is the current loader's name, VK_ICD_FILENAMES the older one.
SupplementaryGroups=render video
Environment=LD_LIBRARY_PATH=/opt/llama.cpp-vulkan
Environment=VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json
Environment=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json
# Mesa keeps its compiled shaders here; without it every start recompiles them.
CacheDirectory=mnemerynne-llama
Environment=XDG_CACHE_HOME=/var/cache/mnemerynne-llama
# Localhost only: llama-server has no authentication. 16k context split
# across 2 slots. To run Qwen3-8B instead, change -m and the label in
# MNEMERYNNE_LLM_MODEL; keep -c at 16384 or lower on the 8 GB card.
#
# LFM2.5 (and models fine-tuned from it) thinks before it answers: its chat
# template always opens a <think> block, and its answers are much better for
# it. --reasoning-format deepseek moves the thinking out of the reply, and
# MNEMERYNNE_LLM_REASONING_TOKENS (default 1024) gives every call room for it
# on top of its answer budget. lfm2-no-think.jinja with --reasoning-format none
# turns thinking off instead: JSON from the first token, but erinne-0.1 then
# refused questions it answers fine when it may think (21 Oct 2026), so only
# use that for a model trained and evaluated that way.
ExecStart=/opt/llama.cpp-vulkan/llama-server --host 127.0.0.1 --port 8086 -dev Vulkan0 -ngl 99 \
    -m /opt/models/LFM2.5-2.6B-Q4_K_M.gguf -c 16384 -np 2 \
    --jinja --reasoning-format deepseek
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
