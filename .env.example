# Copy to .env and adjust. Every setting can also be an environment variable.

# Where the database and uploaded files live (relative to the working directory,
# or absolute; on the Fedora box: /var/lib/erinne).
ERINNE_DATA_DIR=data

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ERINNE_SECRET_KEY=

# Set to true once served over HTTPS (behind nginx).
ERINNE_SESSION_HTTPS_ONLY=false

ERINNE_HOST=127.0.0.1
ERINNE_PORT=38200

# Usernames that are always admins, comma-separated (bootstrap only;
# normally use the admin role).
ERINNE_ADMIN_USERS=

# llama-server endpoints (generator and embedder).
ERINNE_LLM_URL=http://127.0.0.1:8081
ERINNE_EMBED_URL=http://127.0.0.1:8082
