# Copy to .env and adjust. Every setting can also be an environment variable.

# Where the database and uploaded files live (relative to the working directory,
# or absolute; on the Fedora box: /var/lib/mnemerynne).
MNEMERYNNE_DATA_DIR=data

# Session signing key; also encrypts stored credentials. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Optional for development on 127.0.0.1; required (32+ characters) once
# MNEMERYNNE_PUBLIC_URL is set or the host isn't loopback.
MNEMERYNNE_SECRET_KEY=

MNEMERYNNE_HOST=127.0.0.1
MNEMERYNNE_PORT=38200

# The address people open Erynne at; citation links sent to Claude are built
# on it (relative links when empty). Session cookies become HTTPS-only when
# it's https (override with MNEMERYNNE_SESSION_HTTPS_ONLY).
MNEMERYNNE_PUBLIC_URL=

# Usernames that are always admins, comma-separated (bootstrap only;
# normally use the admin role).
MNEMERYNNE_ADMIN_USERS=

# llama-server endpoints (generator and embedder).
MNEMERYNNE_LLM_URL=http://127.0.0.1:8081
MNEMERYNNE_EMBED_URL=http://127.0.0.1:8082

# Teacher for training/evaluation data (gen-sft, router-data, draft-gold).
# Default: the local generator. To use the OpenAI API instead:
#   MNEMERYNNE_TEACHER_FLAVOR=openai
#   MNEMERYNNE_TEACHER_API_KEY=sk-...
#   MNEMERYNNE_TEACHER_MODEL=gpt-6-luna
#   MNEMERYNNE_TEACHER_ALLOWED_LIBRARIES=Oracle
# A remote teacher only ever receives text from the libraries listed in
# MNEMERYNNE_TEACHER_ALLOWED_LIBRARIES (comma-separated), or from everything with
# "*". Don't list libraries whose documents may not go to third parties.
MNEMERYNNE_TEACHER_FLAVOR=llamacpp
