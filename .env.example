# Copy to .env and adjust. Every setting can also be an environment variable.

# Where the database and uploaded files live (relative to the working directory,
# or absolute; on the Fedora box: /var/lib/erinne).
ERINNE_DATA_DIR=data

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ERINNE_SECRET_KEY=

# Set to true once served over HTTPS (behind nginx).
ERINNE_SESSION_HTTPS_ONLY=false

ERINNE_HOST=127.0.0.1
ERINNE_PORT=38200

# Usernames that are always admins, comma-separated (bootstrap only;
# normally use the admin role).
ERINNE_ADMIN_USERS=

# llama-server endpoints (generator and embedder).
ERINNE_LLM_URL=http://127.0.0.1:8081
ERINNE_EMBED_URL=http://127.0.0.1:8082

# Teacher for training/evaluation data (gen-sft, router-data, draft-gold).
# Default: the local generator. To use the OpenAI API instead:
#   ERINNE_TEACHER_FLAVOR=openai
#   ERINNE_TEACHER_API_KEY=sk-...
#   ERINNE_TEACHER_MODEL=gpt-6-luna
#   ERINNE_TEACHER_ALLOWED_LIBRARIES=Oracle
# A remote teacher only ever receives text from the libraries listed in
# ERINNE_TEACHER_ALLOWED_LIBRARIES (comma-separated), or from everything with
# "*". Don't list libraries whose documents may not go to third parties.
ERINNE_TEACHER_FLAVOR=llamacpp
